		<section class="cabin" hidden aria-label="Inside the command module">
			<div class="cabin-view"></div>
			<span class="cabin-reticle" aria-hidden="true"></span>
			<header class="cabin-bar">
				<p><b>VSL-01</b> Command module, aboard ML-1</p>
				<button class="cabin-leave" type="button">Leave the module <kbd>Esc</kbd></button>
			</header>
			<button class="cabin-prompt" type="button"><span class="keys">Press <kbd>F</kbd> to open the hatch</span><span class="touch">Tap to open the hatch</span></button>
			<button class="cabin-capture" type="button">Click to look around<span>Move the mouse to look, <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> to walk, <kbd>Esc</kbd> to free the mouse</span></button>
			<p class="cabin-help"><span class="keys"><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> to walk</span><span class="touch">Use the pad to walk</span><span class="keys">, the mouse to look, <kbd>Esc</kbd> to free the mouse</span><span class="touch">, drag to look around</span>. Press <kbd>F</kbd> at the hatch to return to the ship.</p>
			<div class="cabin-pad" aria-hidden="true">
				<button type="button" data-key="f" style="grid-area: f">▲</button>
				<button type="button" data-key="l" style="grid-area: l">◀</button>
				<button type="button" data-key="b" style="grid-area: b">▼</button>
				<button type="button" data-key="r" style="grid-area: r">▶</button>
			</div>
		</section>

		<script type="application/json" id="body-data" set:html={JSON.stringify({ bodies, vessel: vesselSpec })} />
		<script type="application/json" id="view-data" set:html={JSON.stringify({ views, names: viewName })} />
		<script type="application/json" id="cabin-data" set:html={JSON.stringify(cabinData)} />

		<script>
			import { createPlot, type BodySpec, type CloseFrame, type PlotOptions } from '../scripts/debrief-plot';
			import { createCabin, type Cabin, type CabinContent } from '../scripts/cabin';

			const { bodies, vessel }: { bodies: BodySpec[]; vessel: PlotOptions['vessel'] } = JSON.parse(document.getElementById('body-data')!.textContent!);
			const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

			// ---------- Tactical plot: three.js scene, HTML targets track it ----------
			const plot = document.querySelector<HTMLElement>('.plot')!;
			const targetsLayer = plot.querySelector<HTMLElement>('.targets')!;
			const buttons = new Map<string, HTMLButtonElement>();
			targetsLayer.querySelectorAll<HTMLButtonElement>('.target').forEach((b) => buttons.set(b.dataset.id!, b));
			const marks = new Map<string, HTMLElement>();
			plot.querySelectorAll<HTMLElement>('.yr').forEach((m) => marks.set(m.dataset.key!, m));

			// Label sizes are measured up front and on resize; measuring every frame would force layout
			const tagSize = new Map<string, { w: number; h: number }>();
			const measureTags = () => buttons.forEach((b, id) => {
				const t = b.querySelector<HTMLElement>('.tag')!;
				tagSize.set(id, { w: t.offsetWidth, h: t.offsetHeight });
			});
			measureTags();
			document.fonts?.ready.then(measureTags);
			addEventListener('resize', measureTags);
			let hoveredId = '';

			// ---------- Close-up: the camera flies to one body; callouts point at it, or at the sites pinned to it ----------
			// Declared before the plot because the plot draws its first frame as soon as it is created.
			// A view is the star, a world (its sites listed beside their pins), or one site (its debrief, all leaders from its pin).
			type View = {
				key: string; host: string; pins: number; geo: [number, number][] | null; pin: number; desig: string; name: string; kind: string; hint?: string;
				status: string; statusText: string; points: { label: string; text: string; go: string }[];
				link: { href: string; label: string } | null; enter: boolean; back: string; backLabel: string; prev: string; next: string;
			};
			const viewData: { views: View[]; names: Record<string, string> } = JSON.parse(document.getElementById('view-data')!.textContent!);
			const views = new Map(viewData.views.map((v) => [v.key, v]));
			const cu = plot.querySelector<HTMLElement>('.closeup')!;
			const cuLeaders = cu.querySelector<SVGGElement>('.cu-leaders')!;
			const cuRings = [...cu.querySelectorAll<SVGCircleElement>('.cu-reticle')];
			const cuPoints = cu.querySelector<HTMLOListElement>('.cu-points')!;
			const cuPins = cu.querySelector<HTMLElement>('.cu-pins')!;
			const SVG_NS = 'http://www.w3.org/2000/svg';
			let cuView: View | null = null; // the view on screen, or on its way
			let cuHost = ''; // the body the camera holds
			let cuLabels: { x: number; y: number }[] = []; // each callout label's left middle, in plot px
			let cuOrder: number[] = []; // which pin each listed entry belongs to, top to bottom
			let lastPins: { x: number; y: number; front: number }[] = [];
			let readyTimer = 0;

			// Wide screens hold the body left of center with the callouts beside it; narrow ones put it on top and stack the text below
			function cuFrame(): CloseFrame {
				const w = plot.clientWidth, h = plot.clientHeight;
				const narrow = w < 760 || w / h < 0.95;
				const f = narrow ? { x: 0.5, y: 0.32, r: Math.min(w * 0.34, h * 0.17) } : { x: 0.29, y: 0.6, r: Math.min(h * 0.34, w * 0.21) };
				cu.classList.toggle('narrow', narrow);
				cu.style.setProperty('--cu-col', `${Math.round(f.x * w + f.r + 96)}px`);
				cu.style.setProperty('--cu-top', `${Math.round(f.y * h + f.r + 28)}px`);
				return f;
			}

			function measureCloseup() {
				const box = plot.getBoundingClientRect();
				cuLabels = [...cuPoints.querySelectorAll('.cu-label')].map((l) => {
					const r = l.getBoundingClientRect();
					return { x: r.left - box.left, y: r.top + r.height / 2 - box.top };
				});
			}

			// One numbered pin per site of the held world; picking a pin opens that site
			function buildPins(v: View) {
				cuPins.replaceChildren(...Array.from({ length: v.pins }, (_, i) => {
					const b = document.createElement('button');
					b.type = 'button';
					b.className = 'cu-pin';
					b.textContent = String(i + 1);
					const site = viewData.views.find((x) => x.host === v.host && x.pin === i)!;
					b.dataset.go = site.key;
					b.setAttribute('aria-label', `${site.desig} ${site.name}`);
					b.addEventListener('click', () => goCloseup(site.key, cuView?.pin !== -1));
					return b;
				}));
			}

			function markPins(v: View) {
				[...cuPins.children].forEach((b, i) => {
					b.classList.toggle('on', i === v.pin);
					b.classList.toggle('dim', v.pin >= 0 && i !== v.pin);
				});
			}

			function fillCloseup(v: View) {
				cu.querySelector('.cu-desig')!.textContent = v.desig;
				const status = cu.querySelector('.cu-status')!;
				status.textContent = v.statusText;
				status.className = `cu-status ${v.status}`;
				cu.querySelector('.cu-name')!.textContent = v.name;
				cu.querySelector('.cu-kind')!.textContent = v.kind;
				cu.querySelector('.cu-hint')!.textContent = v.hint ?? '';
				const link = cu.querySelector<HTMLAnchorElement>('.cu-link')!;
				link.hidden = !v.link;
				if (v.link) {
					link.href = v.link.href;
					link.querySelector('.cu-link-text')!.textContent = v.link.label;
				}
				cu.querySelector<HTMLButtonElement>('.cu-enter')!.hidden = !v.enter;
				// A list of sites runs in the order its pins sit on screen, top to bottom, so no two leaders cross;
				// each entry keeps its pin's number
				cuOrder = v.points.map((_, i) => i);
				if (v.pin < 0 && v.pins && lastPins.length === v.pins) cuOrder.sort((a, z) => lastPins[a].y - lastPins[z].y);
				cuPoints.replaceChildren(...cuOrder.map((pi, i) => {
					const p = v.points[pi];
					const li = document.createElement('li');
					li.className = 'cu-point';
					li.style.setProperty('--i', String(i));
					const label = document.createElement('p');
					label.className = 'cu-label';
					const num = document.createElement('b');
					num.textContent = String(pi + 1).padStart(2, '0');
					label.append(num, p.label);
					const text = document.createElement('p');
					text.className = 'cu-text';
					text.textContent = p.text;
					if (p.go) {
						// A world lists its sites: each entry is a button to that site
						const go = document.createElement('button');
						go.type = 'button';
						go.className = 'cu-go';
						go.append(label, text);
						go.addEventListener('click', () => goCloseup(p.go));
						li.append(go);
					} else li.append(label, text);
					return li;
				}));
				cuLeaders.replaceChildren(...v.points.map((_, i) => {
					const g = document.createElementNS(SVG_NS, 'g');
					g.style.setProperty('--i', String(i));
					const path = document.createElementNS(SVG_NS, 'path');
					path.setAttribute('pathLength', '1');
					const halo = document.createElementNS(SVG_NS, 'circle');
					halo.setAttribute('r', '6');
					halo.classList.add('halo');
					const dot = document.createElementNS(SVG_NS, 'circle');
					dot.setAttribute('r', '2.5');
					dot.classList.add('dot');
					g.append(path, halo, dot);
					return g;
				}));
				cu.querySelectorAll<HTMLButtonElement>('.cu-step').forEach((b) => {
					const to = Number(b.dataset.step) < 0 ? v.prev : v.next;
					b.dataset.id = to;
					b.querySelector('.cu-step-name')!.textContent = viewData.names[to];
					b.setAttribute('aria-label', `${Number(b.dataset.step) < 0 ? 'Previous' : 'Next'}: ${viewData.names[to]}`);
				});
				const back = cu.querySelector<HTMLButtonElement>('.cu-back')!;
				back.firstChild!.textContent = `${v.backLabel} `;
				markPins(v);
				measureCloseup();
			}

			// Every frame: a reticle rings the body, and a leader runs to each callout from its site's pin,
			// from the chosen site's pin, or (for the star) from a point on its disc
			function drawCloseup(p: { x: number; y: number; r: number }, pins: { x: number; y: number; front: number }[]) {
				cuRings.forEach((c, i) => {
					c.setAttribute('cx', String(p.x));
					c.setAttribute('cy', String(p.y));
					c.setAttribute('r', String(p.r * (i ? 1.15 : 1.07)));
				});
				[...cuPins.children].forEach((b, i) => {
					const pin = pins[i];
					const el = b as HTMLElement;
					if (!pin) return;
					// The translate property, not transform, so the pin's own scale stays centered on its spot
					el.style.translate = `${pin.x}px ${pin.y}px`;
					el.classList.toggle('behind', pin.front < 0.08);
				});
				const v = cuView;
				if (!v) return;
				const n = cuLabels.length;
				[...cuLeaders.children].forEach((g, i) => {
					const label = cuLabels[i];
					if (!label) return;
					let ax: number, ay: number;
					const pin = v.pin >= 0 ? pins[v.pin] : v.pins ? pins[cuOrder[i]] : null;
					if (pin) { ax = pin.x; ay = pin.y; }
					else {
						const a = ((-48 + (96 * i) / Math.max(n - 1, 1)) * Math.PI) / 180;
						ax = p.x + Math.cos(a) * p.r * 0.94;
						ay = p.y + Math.sin(a) * p.r * 0.94;
					}
					const end = label.x - 12;
					g.children[0].setAttribute('d', `M${ax},${ay} L${end - 40},${label.y} L${end},${label.y}`);
					for (const c of [g.children[1], g.children[2]]) {
						c.setAttribute('cx', String(ax));
						c.setAttribute('cy', String(ay));
					}
				});
			}

			function openCloseup(key: string) {
				const v = views.get(key);
				if (!v || v === cuView) return;
				const was = cuView;
				cuView = v;
				hoveredId = '';
				plot.classList.add('cu-on');
				cu.classList.toggle('vessel', v.host === 'vessel');
				shipHover = -1;
				tip.classList.remove('on');
				scene.highlightVessel(-1, v.host === 'vessel' ? v.pin : -1);
				cu.inert = false;
				cu.classList.remove('ready');
				clearTimeout(readyTimer);
				const show = () => { fillCloseup(v); cu.classList.add('ready'); };
				if (v.host !== cuHost) {
					// A new body: fly there first, then the text arrives
					cuHost = v.host;
					scene.closeup(v.host, cuFrame(), v.geo ?? v.pins, v.pin);
					buildPins(v);
					if (reduced) show();
					else readyTimer = window.setTimeout(show, was ? 1100 : 1300);
				} else if (v.host === 'vessel') {
					// Aboard the vessel the camera moves between the whole ship and one section
					scene.closeup(v.host, cuFrame(), v.pins, v.pin);
					markPins(v);
					if (reduced) show();
					else readyTimer = window.setTimeout(show, 1000);
				} else {
					// Same body, another level: the camera holds and only the text swaps
					markPins(v);
					if (reduced) show();
					else readyTimer = window.setTimeout(show, 260);
				}
			}

			function closeCloseup() {
				if (!cuView) return;
				cuView = null;
				cuHost = '';
				clearTimeout(readyTimer);
				cu.classList.remove('ready');
				plot.classList.remove('cu-on');
				cu.inert = true;
				cuPins.replaceChildren();
				cu.classList.remove('vessel');
				shipHover = -1;
				tip.classList.remove('on');
				plot.classList.remove('ship-hover');
				scene.highlightVessel(-1, -1);
				scene.closeup('', cuFrame());
			}

			// ---------- Aboard the vessel: point at a section to name it, click to open it ----------
			const tip = cu.querySelector<HTMLElement>('.cu-tip')!;
			let shipHover = -1;
			const sectionKey = (i: number) => viewData.views.find((x) => x.host === 'vessel' && x.pin === i)?.key ?? '';
			function hoverShip(i: number) {
				if (i === shipHover) return;
				shipHover = i;
				plot.classList.toggle('ship-hover', i >= 0);
				scene.highlightVessel(i, cuView?.host === 'vessel' ? cuView.pin : -1);
				if (i < 0) { tip.classList.remove('on'); return; }
				const v = views.get(sectionKey(i))!;
				tip.replaceChildren(Object.assign(document.createElement('b'), { textContent: v.desig }), ` ${v.name}`);
				tip.classList.add('on');
			}
			let downAt: [number, number] | null = null;
			plot.addEventListener('pointermove', (e) => {
				if (cuHost !== 'vessel' || plot.classList.contains('dragging') || e.pointerType === 'touch') return;
				if ((e.target as Element).closest('button, a, [data-nodrag]')) { hoverShip(-1); return; }
				hoverShip(scene.pickVessel(e.clientX, e.clientY));
			});
			plot.addEventListener('pointerleave', () => hoverShip(-1));
			plot.addEventListener('pointerdown', (e) => { downAt = [e.clientX, e.clientY]; });
			plot.addEventListener('click', (e) => {
				if (cuHost !== 'vessel' || !cuView || (e.target as Element).closest('button, a, [data-nodrag]')) return;
				if (downAt && Math.hypot(e.clientX - downAt[0], e.clientY - downAt[1]) > 6) return; // that was a drag
				const i = scene.pickVessel(e.clientX, e.clientY);
				if (i < 0 || i === cuView.pin) return;
				hoverShip(-1);
				goCloseup(sectionKey(i), cuView.pin >= 0);
			});

			const scene = createPlot(plot, bodies, {
				reduced,
				vessel,
				zoomNeedsModifier: () => !document.documentElement.classList.contains('immersive'),
				onFrame(bodies, labels, _sun, pins) {
					const w = plot.clientWidth;
					if (cuHost) {
						const p = bodies.find((b) => b.key === cuHost);
						lastPins = pins;
						if (p) drawCloseup(p, pins);
						// The hover label sits beside the section it names
						if (cuHost === 'vessel' && shipHover >= 0 && pins[shipHover]) tip.style.translate = `${pins[shipHover].x}px ${pins[shipHover].y}px`;
					}
					// Place labels in priority order (hovered, then nearer and larger planets);
					// a label that would overlap one already placed fades out until its planet is hovered
					const priority = (key: string, r: number) => (key === hoveredId ? 1e5 : r);
					const placed: { l: number; t: number; r: number; b: number }[] = [];
					for (const b of [...bodies].sort((a, z) => priority(z.key, z.r) - priority(a.key, a.r))) {
						const btn = buttons.get(b.key);
						if (!btn) continue; // Earth has no target yet
						const r = Math.max(b.r, 6);
						const flip = b.x > w * 0.6;
						btn.style.transform = `translate(${b.x}px, ${b.y}px)`;
						btn.style.setProperty('--r', `${r}px`);
						btn.classList.toggle('flip', flip);
						// Matches the .tag offsets in CSS: beside the hit area, its bottom just above the planet
						const size = tagSize.get(b.key) ?? { w: 0, h: 0 };
						const left = flip ? b.x - r - 4 - size.w : b.x + r + 4;
						const top = b.y - r + 2 - size.h;
						const box = { l: left, t: top, r: left + size.w, b: top + size.h };
						const overlaps = placed.some((p) => box.l < p.r && box.r > p.l && box.t < p.b && box.b > p.t);
						const hide = overlaps && b.key !== hoveredId;
						btn.classList.toggle('tag-hidden', hide);
						if (!hide) placed.push(box);
					}
					for (const l of labels) marks.get(l.key)!.style.transform = `translate(${l.x}px, ${l.y}px)`;
				},
			});

			// Hold the planets still while a pointer or keyboard is on a target, and give its label priority
			const targetId = (e: Event) => (e.target as Element).closest<HTMLElement>('.target')?.dataset.id ?? '';
			targetsLayer.addEventListener('pointerover', (e) => { hoveredId = targetId(e); if (hoveredId) scene.setPaused(true); });
			targetsLayer.addEventListener('pointerout', () => { hoveredId = ''; scene.setPaused(false); });
			targetsLayer.addEventListener('focusin', (e) => { hoveredId = targetId(e); scene.setPaused(true); });
			targetsLayer.addEventListener('focusout', () => { hoveredId = ''; scene.setPaused(false); });

			// Every body on the plot, the vessel included, and every register row opens its close-up; each view has its own hash
			const isCloseup = (key: string) => views.has(key);
			function goCloseup(id: string, replace = false) {
				if (replace) history.replaceState(null, '', `#${id}`);
				else if (location.hash !== `#${id}`) history.pushState(null, '', `#${id}`);
				route();
			}
			buttons.forEach((b) => b.addEventListener('click', () => goCloseup(b.dataset.id!)));
			cu.querySelectorAll<HTMLButtonElement>('.cu-step').forEach((b) => b.addEventListener('click', () => goCloseup(b.dataset.id!, true)));
			// Back climbs one level: a site returns to its world, a world or the star to the full system
			function goBack() {
				if (cuView?.back) goCloseup(cuView.back, true);
				else goFullView();
			}
