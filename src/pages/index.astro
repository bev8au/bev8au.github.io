				position: absolute;
				top: 92px; left: 28px;
				max-width: min(600px, 46vw);
				text-shadow: 0 1px 14px rgba(0, 0, 0, 0.9);
			}
			.cu-head { display: flex; gap: 12px; align-items: center; font: 600 0.9rem/1 var(--data); letter-spacing: 0.1em; color: var(--dim); }
			.cu-status { padding: 4px 8px 3px; font-size: 0.78rem; letter-spacing: 0.06em; color: var(--ice); border: 1px solid rgba(228, 236, 247, 0.3); text-shadow: none; }
			.cu-status.flight { color: #0b0f18; background: var(--amber); border-color: var(--amber); }
			.cu-status.home { color: var(--amber); border-color: rgba(242, 177, 59, 0.6); }
			.cu-name { margin-top: 10px; font: 400 clamp(1.6rem, 2.8vw, 2.5rem)/1.1 var(--display); letter-spacing: 0.02em; color: #fff; }
			.cu-kind { margin-top: 8px; font: 500 1.02rem/1.3 var(--data); letter-spacing: 0.04em; color: var(--dim); }
			.cu-points {
				position: absolute;
				left: var(--cu-col); right: 32px;
				top: 50%;
				max-width: 500px;
				max-height: calc(100% - 200px);
				overflow-y: auto;
				translate: 0 -50%;
				display: grid;
				gap: 18px;
				padding: 4px 8px 4px 0;
				scrollbar-width: thin;
			}
			.cu-label { display: flex; gap: 10px; align-items: baseline; font: 600 0.8rem/1.3 var(--data); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ice); }
			.cu-label b { font-weight: 600; color: var(--amber); }
			.cu-text { margin-top: 5px; font-size: 0.95rem; line-height: 1.5; color: #d3dcea; text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9); }
			.cu-title .cu-link, .cu-title .cu-enter { margin-top: 14px; }
			.cu-title [hidden] { display: none; }
			.cu-enter { padding: 10px 2px; font-size: 1.05rem; color: var(--amber); background: none; border: 0; cursor: pointer; }
			.cu-enter:hover, .cu-enter:focus-visible { color: #fff; }

			/* ---------- Inside the command module ---------- */
			.cabin { position: fixed; inset: 0; z-index: 60; background: #05070d; opacity: 0; transition: opacity 0.5s ease; touch-action: none; user-select: none; }
			.cabin[hidden] { display: none; }
			.cabin.open { opacity: 1; }
			.cabin.fading { opacity: 0; transition-duration: 0.6s; }
			.cabin-view { position: absolute; inset: 0; cursor: pointer; }
			.cabin.locked .cabin-view { cursor: none; }
			/* While the mouse is free, a card in the middle offers to capture it again */
			.cabin-capture {
				position: absolute; left: 50%; top: 50%; translate: -50% -50%;
				display: flex; flex-direction: column; align-items: center; gap: 10px;
				padding: 20px 28px 18px;
				font: 600 1.1rem/1.2 var(--data); letter-spacing: 0.08em; text-transform: uppercase; color: #fff;
				background: rgba(6, 10, 18, 0.72); border: 1px solid rgba(111, 214, 255, 0.55); backdrop-filter: blur(4px);
				cursor: pointer;
			}
			.cabin-capture span { font: 500 0.82rem/1.4 var(--data); letter-spacing: 0.04em; text-transform: none; color: var(--dim); }
			.cabin-capture kbd { padding: 1px 5px; margin: 0 2px; font: 600 0.7rem/1.2 var(--data); color: var(--ice); border: 1px solid rgba(228, 236, 247, 0.25); }
			.cabin-capture:hover, .cabin-capture:focus-visible { border-color: var(--amber); }
			.cabin.locked .cabin-capture, .cabin.leaving .cabin-capture, .cabin.no-lock .cabin-capture { display: none; }
			.cabin.no-lock .cabin-view { cursor: grab; }
			.cabin-view canvas { display: block; width: 100%; height: 100%; }
			.cabin-reticle { position: absolute; left: 50%; top: 50%; width: 6px; height: 6px; margin: -3px; border: 1px solid rgba(255, 255, 255, 0.6); border-radius: 50%; pointer-events: none; }
			.cabin-bar { position: absolute; inset: 0 0 auto; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 28px 40px; background: linear-gradient(rgba(3, 5, 10, 0.7), transparent); pointer-events: none; }
			.cabin-bar > * { pointer-events: auto; }
			.cabin-bar p { font: 600 0.85rem/1.2 var(--data); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ice); }
			.cabin-bar b { font-weight: 600; color: var(--amber); margin-right: 8px; }
			.cabin-leave { padding: 8px 12px; font: 600 0.85rem/1 var(--data); letter-spacing: 0.06em; color: var(--ice); background: rgba(8, 12, 22, 0.6); border: 1px solid rgba(228, 236, 247, 0.25); cursor: pointer; }
			.cabin-leave:hover, .cabin-leave:focus-visible { border-color: var(--amber); color: #fff; }
			.cabin-leave kbd, .cabin-help kbd { padding: 1px 5px; font: 600 0.7rem/1.2 var(--data); color: var(--dim); border: 1px solid rgba(228, 236, 247, 0.25); }
			.cabin-help { position: absolute; left: 50%; bottom: 24px; translate: -50% 0; max-width: calc(100% - 32px); font: 500 0.9rem/1.5 var(--data); letter-spacing: 0.04em; text-align: center; color: var(--dim); text-shadow: 0 1px 8px #000; pointer-events: none; }
			.cabin-help kbd { margin-right: 3px; color: var(--ice); }
			.cabin-help .touch { display: none; }
			.cabin-prompt { position: absolute; left: 50%; top: 62%; translate: -50% 0; padding: 9px 16px 8px; font: 600 0.95rem/1.2 var(--data); letter-spacing: 0.06em; color: #fff; background: rgba(8, 12, 22, 0.72); border: 1px solid rgba(95, 210, 138, 0.7); opacity: 0; transition: opacity 0.3s; pointer-events: none; white-space: nowrap; }
			.cabin-prompt.on { opacity: 1; pointer-events: auto; cursor: pointer; }
			.cabin-prompt kbd { padding: 1px 6px; margin: 0 3px; font: 600 0.8rem/1.2 var(--data); color: #fff; border: 1px solid rgba(95, 210, 138, 0.8); }
			.cabin-prompt .touch { display: none; }
			.cabin-pad { position: absolute; left: 24px; bottom: 72px; display: none; grid-template: 'x f y' 54px 'l b r' 54px / 54px 54px 54px; gap: 6px; }
			.cabin-pad button { font-size: 1.1rem; color: var(--ice); background: rgba(8, 12, 22, 0.55); border: 1px solid rgba(228, 236, 247, 0.3); touch-action: none; }
			@media (hover: none) and (pointer: coarse) {
				.cabin-pad { display: grid; }
				.cabin-capture { display: none; }
				.cabin-prompt .keys { display: none; }
				.cabin-prompt .touch { display: inline; }
				.cabin-help .keys { display: none; }
				.cabin-help .touch { display: inline; }
				.cabin-help { bottom: 16px; font-size: 0.8rem; }
				.cabin-prompt { white-space: normal; text-align: center; width: max-content; max-width: calc(100% - 32px); }
				.cabin-bar { padding: 14px 16px 32px; }
			}
			/* A world lists its sites; each entry opens that site */
			.cu-go {
				display: block;
				width: 100%;
				padding: 3px 0 3px 9px;
				text-align: left;
				font: inherit;
				color: inherit;
				background: none;
				border: 0;
				border-left: 1px solid transparent;
				cursor: pointer;
				transition: background-color 0.15s, border-color 0.15s;
			}
			.cu-go:hover, .cu-go:focus-visible { background: rgba(228, 236, 247, 0.06); border-left-color: var(--amber); outline: none; }
			.cu-go:hover .cu-label { color: #fff; }

			/* Sites pinned to the held world's surface, placed every frame */
			.cu-pins { position: absolute; inset: 0; pointer-events: none; }
			.cu-pin {
				position: absolute;
				left: 0; top: 0;
				width: 26px; height: 26px;
				margin: -13px 0 0 -13px;
				display: grid;
				place-items: center;
				padding: 0;
				font: 600 0.8rem/1 var(--data);
				color: var(--ice);
				background: rgba(8, 12, 22, 0.6);
				border: 1px solid rgba(228, 236, 247, 0.75);
				border-radius: 50%;
				backdrop-filter: blur(2px);
				cursor: pointer;
				pointer-events: auto;
				opacity: 0;
				scale: 0.6;
				transition: opacity 0.3s, scale 0.3s, color 0.15s, background-color 0.15s, border-color 0.15s;
				will-change: translate;
			}
			.cu-pin::after { content: ''; position: absolute; inset: -6px; border: 1px solid var(--amber); border-radius: 50%; opacity: 0; pointer-events: none; }
			.ready .cu-pin { opacity: 1; scale: 1; }
			.ready .cu-pin::after { animation: cu-ping 2.6s ease-out infinite; }
			.cu-pin:hover, .cu-pin:focus-visible { color: #fff; border-color: var(--amber); outline: none; }
			.cu-pin.on { color: #0b0f18; background: var(--amber); border-color: var(--amber); scale: 1.15; }
			.ready .cu-pin.dim { opacity: 0.5; }
			.cu-pin.dim::after { display: none; }
			.cu-pin.behind { opacity: 0 !important; pointer-events: none; }

			/* Text arrives once the camera does: title first, then each callout after its leader */
			.cu-title > *, .cu-point { opacity: 0; translate: -10px 0; transition: opacity 0.25s, translate 0.25s; }
			.ready .cu-title > * { opacity: 1; translate: 0 0; transition: opacity 0.5s, translate 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
			.ready .cu-title > :nth-child(2) { transition-delay: 0.08s; }
			.ready .cu-title > :nth-child(3) { transition-delay: 0.16s; }
			.ready .cu-title > :nth-child(4) { transition-delay: 0.3s; }
			.ready .cu-point { opacity: 1; translate: 0 0; transition: opacity 0.5s calc(0.45s + var(--i) * 0.12s), translate 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) calc(0.45s + var(--i) * 0.12s); }

			.cu-bar {
				position: absolute;
				bottom: 20px; left: 50%;
				translate: -50% 0;
				display: flex;
				gap: 6px;
			}
			.cu-bar button {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 9px 14px;
				font: 600 0.82rem/1.2 var(--data);
				letter-spacing: 0.06em;
				white-space: nowrap;
				color: var(--dim);
				background: rgba(8, 12, 22, 0.6);
				border: 1px solid rgba(228, 236, 247, 0.18);
				backdrop-filter: blur(4px);
				cursor: pointer;
				transition: color 0.15s, border-color 0.15s;
			}
			.cu-bar button:hover { color: #fff; border-color: var(--amber); }
			.cu-back { color: var(--ice) !important; }
			.cu-back kbd { padding: 1px 5px; font: 600 0.7rem/1.2 var(--data); color: var(--dim); border: 1px solid rgba(228, 236, 247, 0.25); }
			.cu-step-name { max-width: 22ch; overflow: hidden; text-overflow: ellipsis; }

			/* Narrow screens: the body sits on top, the text scrolls in a sheet below it, and the leaders drop out */
			.closeup.narrow::before { background: linear-gradient(0deg, rgba(3, 5, 10, 0.9) 0%, rgba(3, 5, 10, 0.7) 55%, transparent 72%), linear-gradient(180deg, rgba(3, 5, 10, 0.6), transparent 22%); }
			.closeup.narrow .cu-leaders { display: none; }
			.closeup.vessel .cu-pin, .closeup.vessel .cu-reticle { display: none; }
			/* Hull detail fills the frame aboard the vessel, so the text side gets a deeper scrim */
			.closeup.vessel:not(.narrow)::before {
				background:
					linear-gradient(270deg, rgba(3, 5, 10, 0.94) 0%, rgba(3, 5, 10, 0.78) 30%, rgba(3, 5, 10, 0.3) 52%, transparent 64%),
					linear-gradient(180deg, rgba(3, 5, 10, 0.7), transparent 30%),
					linear-gradient(0deg, rgba(3, 5, 10, 0.55), transparent 16%);
			}
			.plot.ship-hover { cursor: pointer; }
			.cu-hint { margin-top: 12px; font: 500 0.86rem/1.4 var(--data); letter-spacing: 0.04em; color: var(--amber); }
			.cu-hint:empty { display: none; }
			.cu-tip {
				position: absolute;
				left: 0; top: 0;
				margin: 0;
				padding: 7px 12px 6px;
				font: 600 0.92rem/1.2 var(--data);
				letter-spacing: 0.05em;
				white-space: nowrap;
				color: #fff;
				background: rgba(8, 12, 22, 0.72);
				border: 1px solid rgba(242, 177, 59, 0.7);
				backdrop-filter: blur(3px);
				transform: translate(18px, -50%);
				pointer-events: none;
				opacity: 0;
				transition: opacity 0.15s;
			}
			.cu-tip b { font-weight: 600; color: var(--amber); margin-right: 4px; }
			.cu-tip.on { opacity: 1; }
			.closeup.narrow .cu-sheet {
				display: block;
				position: absolute;
				left: 0; right: 0;
				top: var(--cu-top); bottom: 64px;
				padding: 0 16px 20px;
				overflow-y: auto;
				pointer-events: auto;
			}
			.closeup.narrow .cu-title, .closeup.narrow .cu-points { position: static; max-width: none; max-height: none; translate: none; overflow: visible; }
			.closeup.narrow .cu-name { font-size: 1.5rem; }
			.closeup.narrow .cu-points { margin-top: 18px; padding: 0; }
			.closeup.narrow .cu-bar { bottom: 14px; }
			.closeup.narrow .cu-step-name, .closeup.narrow .cu-back kbd { display: none; }
			@media (prefers-reduced-motion: reduce) {
				.closeup *, .closeup *::before { transition: none !important; animation: none !important; }
			}

			/* Opening the console replays the power-on sequence, faster than the first-visit boot */
			@media (prefers-reduced-motion: no-preference) {
				.opening [data-boot] { animation: power-on 0.5s cubic-bezier(0.6, 0, 0.2, 1) backwards; animation-delay: calc(var(--i) * 0.08s); }
				.opening .viewport[data-boot] { animation-name: open-viewport; animation-duration: 0.6s; }
			}

			/* ---------- Responsive ---------- */
			@media (max-width: 980px) {
				.trio { grid-template-columns: 1fr 1fr; }
				.trio > :first-child { grid-column: 1 / -1; }
			}
			@media (max-width: 640px) {
				.immersive .immersive-bar { padding: 16px 16px 32px; }
				.immersive-nav a { padding: 8px 9px; font-size: 0.6rem; }
				.immersive .hud.tl { display: none; }
				.immersive .immersive-hint { bottom: 48px; font-size: 0.8rem; }
				.plot { height: 360px; }
				.tag b { display: none; }
				.hud.br { display: none; }
				.tag { font-size: 0.74rem; }
				.trio, .duo { grid-template-columns: 1fr; }
				.strip p { display: none; }
				.reg-head { display: none; }
				.reg-row { grid-template-columns: 1fr auto; grid-template-areas: 'name status' 'id kind'; row-gap: 4px; }
				.r-name { grid-area: name; }
				.r-status { grid-area: status; }
				.r-id { grid-area: id; font-size: 0.85rem; }
				.r-kind { grid-area: kind; font-size: 0.85rem; text-align: right; }
				.r-year { display: none; }
				.kv div, .dossier .kv div { grid-template-columns: 84px 1fr; }
				.dossier > .portrait { float: none; width: min(220px, 62%); margin: 0 0 14px; }
			}
		</style>
	</body>
</html>
