---
import '../styles/console.css';
import { tabs as navTabs } from '../data/nav';
import { profile } from '../data/profile';
import Portrait from '../components/Portrait.astro';
import fieldPhoto from '../assets/portraits/field-photo.jpg';
import { commandModule } from '../data/command-module';

const cabinPhotos = import.meta.glob<ImageMetadata>('../assets/cabin/*.jpg', { eager: true, import: 'default' });
// Design D: Mission debrief. An unfamiliar star with four worlds, one per kind of experience: academic, professional,
// engagement, and research. Picking a world flies the camera in; its sites are pinned to the surface, and picking
// a site opens its debrief. A crewed vessel orbits out of the planets' plane: its command module holds my profile,
// and each habitat bay one of my interests. Motion language borrowed from 2Advanced V3.
// Within a world, sites run newest first by their start date and take their designations in that order (PRO-01 is
// the most recent), so a new site can go anywhere in its list.
const worldData = [
	{
		id: 'academic', code: 'ACA', name: 'Academic', look: 'saturn', size: 0.8, orbit: 13, phase: 2.6,
		blurb: 'Consulting projects in the McIntire core, teaching finance, and my coursework.',
		sites: [
			{
				name: 'ICE: Allianz and Uber', kind: 'Integrated Core Experience', status: 'complete',
				objective: "Two client projects in McIntire's ICE courses: a new client service for Allianz and an proposed acquisition for Uber.",
				outcome: 'Modeled a global travel repatriation service for Allianz at a 25.09% IRR and presented it to Allianz executives. Proposed Uber acquiring GoTo, with $1.9B in projected synergies and a half-cash, half-stock structure.',
				focus: 'Financial modeling, M&A Synergy, Deal structure, Consulting, Market Research', place: 'UVA McIntire', dates: 'Sep 2025 to May 2026',
			},
			{
				name: 'Teaching Assistant', kind: 'GCOM 7060 and COMM 2002', status: 'complete',
				objective: 'Support students in two core finance courses at McIntire.',
				outcome: 'Led office hours and review sessions for 300+ students on the time value of money, CAPM, portfolio theory, capital budgeting, and company valuation.',
				focus: 'Teaching, Corporate finance, Financial management', place: 'UVA McIntire', dates: 'Sep 2025 to May 2026',
			},
			{
				// A course list in place of the usual debrief; the courses mirror education.courses in src/data/experience.ts
				name: 'Coursework', kind: 'BS Commerce, finance concentration, minor in computer science', status: 'flight',
				place: 'UVA McIntire', dates: 'Aug 2023 to May 2027 (expected)',
				points: [
					{ label: 'Tracks', text: 'Quantitative Finance; Analytics and AI' },
					{ label: 'Finance and accounting', text: 'Quantitative & Financial Analysis; Intermediate Corporate Finance; Intermediate Accounting' },
					{ label: 'Computer science', text: 'Data Structures and Algorithms; Discrete Math and Theory' },
					{ label: 'Statistics', text: 'Introduction to Regression Analysis' },
				],
			},
		],
	},
	{
		id: 'professional', code: 'PRO', name: 'Professional', look: 'neptune', size: 0.72, orbit: 16, phase: 4.4,
		blurb: 'Internships across investment banking, private equity, venture capital, equity research, and consulting.',
		sites: [
			{
				name: 'Goldman Sachs GH Securities', kind: 'Investment banking intern', status: 'complete',
				objective: 'Seek buyers for 2 companies in Industrial IoT and AI Agent Infra sectors, and value a leading Chinese automaker.',
				outcome: "Mapped M&A synergies with potential buyers across product, technology, data, and cost, and prepared pitchbook materials for buyer outreach. Built the automaker's valuation model with a Middle East expansion scenario and pitched a block trade to a regional PE firm ahead of a shareholder lockup expiry.",
				focus: 'Investment banking, M&A, Valuation', place: 'Beijing, China', dates: 'Jun 2026 to Aug 2026',
			},
			{
				name: 'China Mobile Investment', kind: 'Corporate investment intern', status: 'complete',
				objective: 'Find edge computing investments in the RISC-V ecosystem and help close a robotics deal.',
				outcome: 'Wrote a 50-page RISC-V industry report, discovering investment opportunities driven by its highly flexible architecture design. Supported a $100M investment closing in a robotics manufacturer by participating in due diligence, unit economics discussion, and the valuation model.',
				focus: 'Private equity, RISC-V, Robotics, Unit economics', place: 'Beijing, China', dates: 'May 2025 to Aug 2025',
			},
			{
				name: 'Portola Growth Partners', kind: 'Private equity intern', status: 'complete',
				objective: 'Source investments in pediatric behavioral health and home medical equipment sectors.',
				outcome: 'Screened 100 startups and contacted five targets. Ran due diligence on Unicare Diagnostics, including EBITDA and margin analysis.',
				focus: 'Private equity, Healthcare investment', place: 'New York', dates: 'Jan 2025 to May 2025',
			},
			{
				name: 'StudentBrains Consulting', kind: 'Student consultant', status: 'complete',
				objective: 'Find potential clients among Charlottesville businesses and help an art auction client grow its revenue.',
				outcome: "Evaluated 50+ local businesses across websites, social media, and third-party platforms to support sales outreach. Broke down the auction client's revenue mix in Excel and Tableau to find its high-value customer segments, key markets, and best outreach channels.",
				focus: 'Consulting, Market research, Revenue analysis', place: 'New York', dates: 'Jan 2025 to May 2025',
			},
			{
				name: 'HUAXI Securities', kind: 'Equity research intern', status: 'complete',
				objective: "Track data-center GPU design and cover a company in China's IoT sector.",
				outcome: "Built a Python dataset of 30+ GPU architectures and used machine learning to forecast next-generation features, consistent with NVIDIA's later releases. Wrote a 40-page industry report and a 17-page due diligence report on a leading Chinese industrial controller company.",
				focus: 'Equity research, Semiconductors, GPU, IoT', place: 'Beijing, China', dates: 'May 2024 to Aug 2024',
			},
			{
				name: 'LXL Capital', kind: 'Venture capital intern', status: 'complete',
				objective: 'Track technology startup financing worldwide and run due diligence on big-data startups.',
				outcome: 'Produced 10 weekly market reports from Crunchbase financing data, estimating valuation ranges from funding-round multiples. Ran due diligence on seven big-data startups and prepared internal investment presentations.',
				focus: 'Venture capital, due diligence, SaaS', place: 'New York', dates: 'Dec 2023 to Mar 2024',
			},
		],
	},
	{
		id: 'engagement', code: 'ENG', name: 'Engagement', look: 'mars', size: 0.45, orbit: 7.4, phase: 1.4,
		blurb: 'Sustainability work on grounds and the Chinese student community at UVA.',
		sites: [
			{
				name: 'Aramark', kind: 'Sustainability intern', status: 'complete',
				objective: 'Support data-driven waste reduction and sustainable dining on grounds.',
				outcome: "Tracked food waste across three dining halls by location, time, and type. Assessed the financial feasibility of 10 campus sustainability projects and organized the monthly C'ville Market, with 2,000+ participants and 30+ local vendors from underserved communities.",
				focus: 'Operation, Sustainability, Data analysis', place: 'Charlottesville, VA', dates: 'Sep 2024 to May 2025',
			},
			{
				name: 'Mainland Student Network', kind: 'Director of publicity', status: 'complete',
				objective: 'Run publicity for events serving Chinese international students at UVA.',
				outcome: 'Helped organize 30+ events, designed 20+ posters, and managed social media. Secured $7,000+ in sponsorships and gave a one-hour solo piano recital at Old Cabell Hall for an audience of 300+.',
				focus: 'Student government, Club outreach', place: 'Charlottesville, VA', dates: 'Sep 2023 to May 2024',
			},
		],
	},
	{
		id: 'research', code: 'RES', name: 'Research', look: 'eris', size: 0.56, orbit: 4.2, phase: 5.4,
		blurb: 'Dark matter in Milky Way-like galaxies, with the UVA Department of Astronomy.',
		sites: [
			{
				name: 'Dark Matter Density Profiles', kind: 'Research assistant, UVA Astronomy', status: 'complete',
				objective: 'Model dark matter in Milky Way-like galaxies to estimate decay and annihilation signals.',
				outcome: 'Processed 1,024 simulated galaxies from the DREAMS collaboration in Python and calculated their D- and J-factors, then used emulators to relate them to galaxy properties. Ninth author of a paper published in The Astrophysical Journal.',
				focus: 'Astrophysics, Dark matter, D&J Factors, Computer Engineering', place: 'Charlottesville, VA', dates: 'May 2024 to Sep 2024',
			},
		],
	},
];
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const startOf = (dates: string) => {
	const [, month, year] = dates.match(/(\w{3}) (\d{4})/)!;
	return Number(year) * 12 + MONTHS.indexOf(month);
};
const worlds = worldData.map((w) => ({
	...w,
	sites: [...w.sites]
		.sort((a, z) => startOf(z.dates) - startOf(a.dates))
		.map((s, i) => ({ ...s, id: `${w.code}-${String(i + 1).padStart(2, '0')}` })),
}));

// The vessel. Its command module comes first, then one habitat bay per interest; stencil and feature dress the bay's pod.
// The interest text is placeholder until it is written.
const vessel = {
	id: 'vessel', code: 'VSL', name: 'ML-1', blurb: 'Survey vessel. The command module carries my profile; each habitat bay, something I love doing.',
	orbit: 10.4, inclination: 0.3, node: 0.9, phase: 0.5,
	command: { name: 'Command Module', kind: 'Pilot dossier', points: profile.about.map((p) => ({ label: p.label, text: p.text })) },
	bays: [
		{ name: 'Basketball', room: 'The Court', stencil: 'COURT', feature: 'court' },
		{ name: 'Astronomy', room: 'The Observatory', stencil: 'OBSERVATORY', feature: 'observatory' },
		{ name: 'Piano', room: 'The Music Room', stencil: 'MUSIC ROOM', feature: 'music' },
		{ name: 'Travel', room: 'The Map Room', stencil: 'MAP ROOM', feature: 'map' },
		{ name: 'Video Games', room: 'The Arcade', stencil: 'ARCADE', feature: 'arcade' },
	].map((b) => ({
		...b,
		points: [
			{ label: 'About', text: `Placeholder: what ${b.name.toLowerCase()} means to me, and how I got into it.` },
			{ label: 'Highlights', text: 'Placeholder: a few moments, achievements, or favourites worth sharing.' },
			{ label: 'Now', text: 'Placeholder: how it fits into my life today.' },
		],
	})),
};
const vesselSections = [
	{ id: 'VSL-01', name: vessel.command.name, kind: vessel.command.kind, statusText: 'Command', points: vessel.command.points },
	...vessel.bays.map((b, i) => ({ id: `VSL-0${i + 2}`, name: b.name, kind: `${b.room}, habitat bay ${i + 1}`, statusText: `Bay ${i + 1}`, points: b.points })),
];
const statusText = { flight: 'In flight', complete: 'Complete' };
// The command module's wall displays (text in src/data/command-module.ts) and what its navigation display plots
const cabinData = {
	name: profile.name,
	panels: commandModule.map((p) => ({
		...p,
		photos: p.photos.map((ph) => ({ src: cabinPhotos[`../assets/cabin/${ph.file}.jpg`].src, caption: ph.caption })),
	})),
	worlds: worlds.map((w) => ({ code: w.code, name: w.name, look: w.look, orbit: w.orbit })),
	vesselOrbit: vessel.orbit,
};
const siteCount = worlds.reduce((n, w) => n + w.sites.length, 0);

// Close-up views, one per hash: the vessel and each world (their sections or sites listed beside their pins),
// and each section or site. A world's sites, or the vessel's sections, step through one another.
const fullRecord = { href: '/experience/', label: 'See the full record' };
// The vessel and the worlds step through one another, the worlds from the star outward
const top = [vessel.id, ...[...worlds].sort((a, z) => a.orbit - z.orbit).map((w) => w.id)];
const around = (list: string[], i: number) => ({ prev: list[(i - 1 + list.length) % list.length], next: list[(i + 1) % list.length] });
const geo = (w: (typeof worlds)[number]) => (w.sites.every((s) => 'at' in s) ? w.sites.map((s) => (s as { at: number[] }).at) : null);
const views = [
	{
		key: vessel.id, host: vessel.id, pins: vesselSections.length, geo: null, pin: -1, desig: vessel.code, name: vessel.name, kind: vessel.blurb,
		hint: 'Point at a part of the ship to see what it is. Click to go aboard.',
		status: 'home', statusText: `${vesselSections.length} sections`,
		points: [],
		link: { href: '/cv/', label: 'View CV' }, back: '', backLabel: 'Back to system', ...around(top, 0),
	},
	...vesselSections.map((s, si) => ({
		key: s.id, host: vessel.id, pins: vesselSections.length, geo: null, pin: si, desig: s.id, name: s.name, kind: `${s.kind}. Aboard ${vessel.name}`,
		status: 'home', statusText: s.statusText, points: s.points.map((p) => ({ ...p, go: '' })),
		link: { href: '/cv/', label: 'View CV' } as { href: string; label: string } | null, enter: false,
		back: vessel.id, backLabel: `Back to ${vessel.name}`, ...around(vesselSections.map((x) => x.id), si),
		// The command module only says whose profile it holds; the profile itself is inside
		...(si === 0 && { name: profile.name, kind: `Personal profile, in the command module of ${vessel.name}`, points: [], link: null, enter: true }),
	})),
	...worlds.flatMap((w) => [
		{
			key: w.id, host: w.id, pins: w.sites.length, geo: geo(w), pin: -1, desig: w.code, name: w.name, kind: w.blurb,
			status: 'home', statusText: `${w.sites.length} ${w.sites.length === 1 ? 'site' : 'sites'}`,
			points: w.sites.map((s) => ({ label: s.name, text: `${s.kind}. ${s.dates}`, go: s.id })),
			link: fullRecord, back: '', backLabel: 'Back to system', ...around(top, top.indexOf(w.id)),
		},
		...w.sites.map((s, si) => ({
			key: s.id, host: w.id, pins: w.sites.length, geo: geo(w), pin: si, desig: s.id, name: s.name, kind: `${s.kind}. ${w.name} world`,
			status: s.status, statusText: statusText[s.status as keyof typeof statusText],
			points: 'points' in s && s.points
				? [...s.points.map((p) => ({ ...p, go: '' })), { label: 'Where and when', text: `${s.place}. ${s.dates}`, go: '' }]
				: [
					{ label: 'Objective', text: s.objective, go: '' },
					{ label: 'Outcome', text: s.outcome, go: '' },
					{ label: 'Focus', text: s.focus, go: '' },
					{ label: 'Where and when', text: `${s.place}. ${s.dates}`, go: '' },
				],
			link: fullRecord, back: w.id, backLabel: `Back to ${w.name}`, ...around(w.sites.map((x) => x.id), si),
		})),
	]),
];
const viewName = Object.fromEntries(views.map((v) => [v.key, `${v.desig} ${v.name}`]));
const bodies = worlds.map(({ id, orbit, phase, look, size }) => ({ id, orbit, phase, look, size }));
const vesselSpec = { orbit: vessel.orbit, inclination: vessel.inclination, node: vessel.node, phase: vessel.phase, bays: vessel.bays.map(({ stencil, feature }) => ({ stencil, feature })) };

// Milestones from the résumé; the Experience page has the full record
const log = [
	{ date: '2023.08', text: 'Launched. Started a BS in Commerce at UVA McIntire, concentrating in finance, minor in computer science.' },
	{ date: '2024.05', text: 'Equity research intern at HUAXI Securities, Beijing. Forecast next-generation data-center GPU features.' },
	{ date: '2025.01', text: 'Private equity intern at Portola Growth Partners, screening pediatric behavioral health startups.' },
	{ date: '2025.05', text: 'Investment intern at China Mobile Investment. Supported a $100M robotics investment closing.' },
	{ date: '2026.06', text: 'Investment banking intern at Goldman Sachs GH Securities, Beijing, on M&A and a block trade pitch.' },
];

// Research written during internships, in pages, and headline figures from the résumé
const reports = [
	{ name: 'RISC-V industry report', org: 'China Mobile Investment', pages: 50 },
	{ name: 'Data-center GPU report', org: 'HUAXI Securities', pages: 40 },
	{ name: 'Wanma Technology due diligence', org: 'HUAXI Securities', pages: 17 },
];
const maxPages = Math.max(...reports.map((r) => r.pages));
const totalPages = reports.reduce((sum, r) => sum + r.pages, 0);
const readings = [
	{ label: 'Startups screened', value: '100' },
	{ label: 'GPU architectures analyzed', value: '30+' },
	{ label: 'Investment closing supported', value: '$100M' },
	{ label: 'GPA', value: '3.9 / 4.0' },
];

// On this page the debrief sections are plain hashes; Writing is its own route
const tabs = navTabs.map((t) => ({ href: 'href' in t ? t.href : t.hash, label: t.label }));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Martin Liu</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Michroma&family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@500;600&display=swap" rel="stylesheet" />
		<script is:inline>
			// Land on the full-screen solar system unless the URL already names a page
			if (!/^#(debrief|sorties|log|dossier|uplink)$/.test(location.hash)) document.documentElement.classList.add('immersive');
			// Boot sequence plays once per session, and never with reduced motion.
			try {
				if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('debrief-booted')) {
					document.documentElement.classList.add('boot');
					sessionStorage.setItem('debrief-booted', '1');
				}
			} catch (e) {}
		</script>
	</head>
	<body>
		<div class="loader" aria-hidden="true">
			<svg viewBox="0 0 60 60" class="ring">
				<circle cx="30" cy="30" r="24" />
				<path d="M30 6 A24 24 0 0 1 54 30" />
				<circle class="core" cx="30" cy="30" r="5" />
			</svg>
			<p>Initializing debrief</p>
		</div>

		<div class="chassis">
			<header class="plate" data-boot style="--i:0">
				<a class="mark" href="#debrief" aria-label="Martin Liu, back to top">
					<svg viewBox="0 0 40 40" aria-hidden="true">
						<ellipse cx="20" cy="20" rx="17" ry="7" transform="rotate(-24 20 20)" />
						<circle cx="20" cy="20" r="6" />
						<circle class="moon" cx="35" cy="13" r="2.4" />
					</svg>
					<span class="wordmark">Martin Liu</span>
				</a>
				<p class="callsign">Survey vessel UVA McIntire <span class="sep">//</span> <time class="clock">--:--:-- UTC</time></p>
			</header>

			<nav class="tabs" aria-label="Sections" data-boot style="--i:1">
				{tabs.map((t, i) => <a href={t.href} class:list={{ on: i === 0 }}>{t.label}</a>)}
			</nav>

			<main>
				<section id="debrief" class="viewport" aria-label="Tactical plot of projects" data-boot style="--i:2">
					<div class="plot">
						<header class="immersive-bar">
							<a class="mark" href="#debrief" aria-label="Martin Liu, open the debrief">
								<svg viewBox="0 0 40 40" aria-hidden="true">
									<ellipse cx="20" cy="20" rx="17" ry="7" transform="rotate(-24 20 20)" />
									<circle cx="20" cy="20" r="6" />
									<circle class="moon" cx="35" cy="13" r="2.4" />
								</svg>
								<span class="wordmark">Martin Liu</span>
							</a>
							<nav class="immersive-nav" aria-label="Pages">
								{tabs.map((t) => <a href={t.href}>{t.label}</a>)}
							</nav>
						</header>
						<p class="immersive-hint" aria-hidden="true">Drag to look around, scroll to zoom. Pick a world to see its sites, or the vessel for my profile.</p>
						<button class="full-view" type="button" aria-label="Return to the full-screen view">
							<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 5V1h4M11 1h4v4M15 11v4h-4M5 15H1v-4" /></svg>
							Full view
						</button>
						<div class="marks" aria-hidden="true">
							<span class="yr belt" data-key="belt">Asteroid belt</span>
						</div>
						<div class="hud tl" aria-hidden="true">
							<p class="hud-title">Tactical plot</p>
							<p>One world per résumé section</p>
						</div>
						<div class="hud br" aria-hidden="true">
							<p>Tracking {worlds.length} worlds, {siteCount} sites, 1 vessel</p>
						</div>
						<ul class="targets" aria-label="Sorties on the plot">
							<li>
								<button class="target vessel" type="button" data-id={vessel.id} aria-label={`${vessel.name}, my vessel. Fly in for my profile`}>
									<span class="marker"></span>
									<span class="tag"><i class="glyph"></i><b>{vessel.code}</b> {vessel.name}, Martin Liu</span>
								</button>
							</li>
							{worlds.map((w) => (
								<li>
									<button class="target" type="button" data-id={w.id} aria-label={`${w.name} world, ${w.sites.length} sites. Fly in`}>
										<span class="marker"></span>
										<span class="tag"><i class="glyph"></i><b>{w.code}</b> {w.name}</span>
									</button>
								</li>
							))}
						</ul>
						<section class="closeup" aria-label="Close-up debrief" inert>
							<svg class="cu-lines" aria-hidden="true">
								<circle class="cu-reticle" r="0" />
								<circle class="cu-reticle fine" r="0" />
								<g class="cu-leaders"></g>
							</svg>
							<div class="cu-pins" data-nodrag></div>
							<p class="cu-tip" aria-hidden="true"></p>
							<div class="cu-sheet" data-nodrag>
								<header class="cu-title" aria-live="polite">
									<p class="cu-head"><span class="cu-desig"></span><span class="cu-status"></span></p>
									<h2 class="cu-name"></h2>
									<p class="cu-kind"></p>
									<p class="cu-hint"></p>
									<a class="cu-link cta" href="/experience/"><span class="cta-gauge" aria-hidden="true"></span><span class="cu-link-text"></span></a>
									<button class="cu-enter cta" type="button" hidden><span class="cta-gauge" aria-hidden="true"></span>Enter the command module</button>
								</header>
								<ol class="cu-points"></ol>
							</div>
							<nav class="cu-bar" data-nodrag aria-label="Close-up">
								<button class="cu-step" type="button" data-step="-1"><span aria-hidden="true">‹</span> <span class="cu-step-name"></span></button>
								<button class="cu-back" type="button">Back to system <kbd>Esc</kbd></button>
								<button class="cu-step" type="button" data-step="1"><span class="cu-step-name"></span> <span aria-hidden="true">›</span></button>
							</nav>
						</section>
					</div>				</section>

				<div class="strip" data-boot style="--i:3">
					<a href="#sorties">Scroll for the full debrief</a>
					<p>Drag to look around, Ctrl + scroll to zoom, double-click to reset</p>
				</div>

				<div class="trio">
					<section id="log" class="panel" aria-labelledby="log-title" data-boot style="--i:4">
						<h2 class="panel-bar" id="log-title"><span class="badge">L</span>Flight log</h2>
						<ol class="log">
							{log.map((e) => (
								<li><time>{e.date}</time><p>{e.text}</p></li>
							))}
						</ol>
					</section>

					<section class="panel" aria-labelledby="tel-title" data-boot style="--i:5">
						<h2 class="panel-bar" id="tel-title"><span class="badge">T</span>Telemetry</h2>
						<div class="tel">
							<p class="reading"><span class="big">{totalPages}</span> pages of research and due diligence reports</p>
								<ol class="reports">
									{reports.map((r) => (
										<li style={`--w:${r.pages / maxPages}`}>
											<span class="r-label">{r.name} <span class="r-org">{r.org}</span></span>
											<span class="r-bar" aria-hidden="true"></span>
											<span class="r-pages">{r.pages}</span>
										</li>
									))}
								</ol>
								<dl class="readings">
									{readings.map((r) => <div><dt>{r.label}</dt><dd>{r.value}</dd></div>)}
								</dl>
						</div>
