---
// Design C: Kinetic type. Each letter of the name swells toward the cursor (variable wght + wdth).
const lines = ['martin', 'liu'];
const projects = [
	{ name: "Hoo's Free", what: 'Shows which study rooms on Grounds are empty right now, scraped from the booking system every five minutes.', stack: 'Python, FastAPI, Svelte', href: 'https://github.com/bev8au' },
	{ name: 'beatbox', what: 'A four-lane rhythm game that runs in the browser. Drop in any MP3 and it builds a chart from the beats.', stack: 'TypeScript, Web Audio', href: 'https://github.com/bev8au' },
	{ name: 'Plant Pager', what: 'A soil-moisture sensor on an ESP32 that texts me before my basil dies. It has saved the basil twice.', stack: 'C++, ESP32, Twilio', href: 'https://github.com/bev8au' },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Martin Liu</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Anybody:wdth,wght@50..150,100..900&display=swap" rel="stylesheet" />
	</head>
	<body>
		<main>
			<header class="hero">
				<h1 class="name" aria-label="Martin Liu">
					{lines.map((line) => (
						<span class="line" aria-hidden="true">
							{[...line].map((ch) => <span class="ch">{ch}</span>)}
						</span>
					))}
				</h1>
				<div class="intro">
					<p>Computer science at UVA. I build small, useful software and the occasional silly game.</p>
					<p class="hint">Move your cursor over my name.</p>
				</div>
			</header>

			<section class="work" aria-labelledby="work-title">
				<h2 id="work-title">Things I've made</h2>
				<ul>
					{projects.map((p) => (
						<li>
							<a href={p.href}>
								<span class="p-name">{p.name}</span>
								<span class="p-what">{p.what}</span>
								<span class="p-stack">{p.stack}</span>
							</a>
						</li>
					))}
				</ul>
			</section>

			<section class="contact" aria-labelledby="contact-title">
				<h2 id="contact-title">Looking for a summer internship.</h2>
				<a class="big" href="mailto:bev8au@virginia.edu">Email me</a>
				<a class="small" href="https://github.com/bev8au">or find me on GitHub</a>
			</section>
		</main>

		<script>
			const chars = [...document.querySelectorAll<HTMLElement>('.ch')];
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const REST_W = 250, PEAK_W = 900, REST_D = 62, PEAK_D = 150;

			const set = (el: HTMLElement, t: number) => {
				el.style.setProperty('--t', t.toFixed(3));
				el.style.fontVariationSettings = `'wght' ${REST_W + (PEAK_W - REST_W) * t}, 'wdth' ${REST_D + (PEAK_D - REST_D) * t}`;
			};

			let px = -1e4, py = -1e4, raf = 0;
			const frame = () => {
				raf = 0;
				const radius = Math.max(window.innerWidth * 0.22, 180);
				for (const el of chars) {
					const r = el.getBoundingClientRect();
					const d = Math.hypot(px - (r.left + r.width / 2), py - (r.top + r.height / 2));
					set(el, Math.max(0, 1 - d / radius) ** 1.5);
				}
			};
			const track = (x: number, y: number) => { px = x; py = y; if (!raf) raf = requestAnimationFrame(frame); };

			if (reduce) {
				chars.forEach((el) => set(el, 0.6));
			} else {
				window.addEventListener('pointermove', (e) => track(e.clientX, e.clientY));
				document.documentElement.addEventListener('pointerleave', () => track(-1e4, -1e4));
				// One wave sweeps across the name on load, left to right.
				const hero = document.querySelector('.name')!.getBoundingClientRect();
				const start = performance.now(), dur = 1400;
				const wave = (now: number) => {
					const k = Math.min(1, (now - start) / dur);
					track(hero.left - 200 + (hero.width + 400) * k, hero.top + hero.height / 2);
					if (k < 1) requestAnimationFrame(wave);
					else track(-1e4, -1e4);
				};
				requestAnimationFrame(wave);
			}
		</script>

		<style is:global>
			:root {
				--ink: #0d1240;
				--deep: #080b2c;
				--paper: #f4f3ff;
				--sun: #ffd23f;
				--lilac: #b9a6ff;
				--muted: #a9a6d6;
			}
			* { box-sizing: border-box; }
			html { background: var(--ink); color: var(--paper); }
			body {
				margin: 0;
				font-family: 'Anybody', system-ui, sans-serif;
				font-variation-settings: 'wdth' 90;
				font-size: 1.125rem;
				line-height: 1.5;
				overflow-x: hidden;
			}
			a { color: inherit; }
			a:focus-visible { outline: 3px solid var(--sun); outline-offset: 6px; }

			.hero {
				min-height: 100svh;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				padding: 2rem 1rem 2.5rem;
				overflow: hidden;
			}
			.name {
				margin: 0;
				font-size: clamp(6rem, 26vw, 24rem);
				line-height: 0.78;
				font-weight: 400;
				letter-spacing: -0.01em;
				user-select: none;
			}
			.line { display: block; white-space: nowrap; }
			.line + .line { padding-left: 0.6em; }
			.ch {
				--t: 0;
				display: inline-block;
				font-variation-settings: 'wght' 250, 'wdth' 62;
				color: color-mix(in oklch, var(--paper), var(--sun) calc(var(--t) * 100%));
			}

			.intro { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem 3rem; }
			.intro p { margin: 0; max-width: 34ch; font-size: clamp(1.15rem, 2vw, 1.5rem); }
			.intro .hint { color: var(--lilac); font-size: 1rem; }

			h2 {
				font-size: clamp(1.25rem, 2.5vw, 1.6rem);
				font-weight: 600;
				color: var(--lilac);
				margin: 0 0 1.5rem;
			}

			.work { padding: 6rem 1rem; background: var(--deep); }
			.work ul { list-style: none; margin: 0; padding: 0; }
			.work li { border-top: 1px solid rgba(185, 166, 255, 0.3); }
			.work li:last-child { border-bottom: 1px solid rgba(185, 166, 255, 0.3); }
			.work a {
				display: grid;
				grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
				grid-template-areas: 'name what' 'name stack';
				gap: 0.25rem 2.5rem;
				align-items: center;
				padding: 1.75rem 0;
				text-decoration: none;
			}
			.p-name {
				grid-area: name;
				font-size: clamp(3rem, 9vw, 7.5rem);
				line-height: 0.9;
				font-variation-settings: 'wght' 850, 'wdth' 55;
				white-space: nowrap;
				transition: font-variation-settings 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.2), color 0.2s;
			}
			.work a:hover .p-name, .work a:focus-visible .p-name { font-variation-settings: 'wght' 900, 'wdth' 125; color: var(--sun); }
			.p-what { grid-area: what; max-width: 42ch; align-self: end; }
			.p-stack { grid-area: stack; color: var(--muted); font-size: 1rem; align-self: start; }

			.contact { padding: 7rem 1rem 8rem; }
			.contact h2 { color: var(--paper); font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 400; }
			.big {
				display: inline-block;
				font-size: clamp(4rem, 15vw, 13rem);
				line-height: 0.9;
				font-variation-settings: 'wght' 900, 'wdth' 70;
				color: var(--sun);
				text-decoration: none;
				transition: font-variation-settings 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.2);
			}
			.big:hover, .big:focus-visible { font-variation-settings: 'wght' 900, 'wdth' 110; }
			.small { display: block; margin-top: 1.5rem; color: var(--lilac); font-size: 1.15rem; text-underline-offset: 0.25em; }

			@media (max-width: 720px) {
				.work a { grid-template-columns: 1fr; grid-template-areas: 'name' 'what' 'stack'; gap: 0.75rem; }
				.p-name { white-space: normal; }
				.intro .hint { display: none; }
			}
			@media (hover: none) {
				.intro .hint { display: none; }
			}
			@media (prefers-reduced-motion: reduce) {
				.p-name, .big { transition: none; }
			}
		</style>
	</body>
</html>
