---
// Design B: Circuit board. Name on the main chip; nav pads light their copper trace.
const pads = [
	{ id: 'about', label: 'About', href: '#about', d: 'M440 262 H300 L200 162 H128', px: 110, py: 162, lx: 110, ly: 122, anchor: 'start' },
	{ id: 'projects', label: 'Projects', href: '#projects', d: 'M760 262 H900 L962 200 H1072', px: 1090, py: 200, lx: 1090, ly: 160, anchor: 'end' },
	{ id: 'github', label: 'GitHub', href: 'https://github.com/bev8au', d: 'M440 378 H320 L202 496 H128', px: 110, py: 496, lx: 110, ly: 456, anchor: 'start' },
	{ id: 'contact', label: 'Contact', href: '#contact', d: 'M760 378 H880 L998 496 H1072', px: 1090, py: 496, lx: 1090, ly: 456, anchor: 'end' },
];
// Decorative traces that don't lead anywhere clickable
const deco = [
	'M500 200 V120 L540 80 H700',
	'M560 200 V140 H640',
	'M700 440 V520 L740 560 H860',
	'M520 440 V560',
	'M640 440 V500 L600 540',
];
const pinsX = Array.from({ length: 8 }, (_, i) => 470 + i * 37);
const pinsY = Array.from({ length: 6 }, (_, i) => 232 + i * 34);
const projects = [
	{ ref: 'U2', name: "Hoo's Free", what: 'Shows which study rooms on Grounds are empty right now, scraped from the booking system every five minutes.', stack: 'Python, FastAPI, Svelte' },
	{ ref: 'U3', name: 'beatbox', what: 'A four-lane rhythm game that runs in the browser. Drop in any MP3 and it builds a chart from the beats.', stack: 'TypeScript, Web Audio' },
	{ ref: 'U4', name: 'Plant Pager', what: 'A soil-moisture sensor on an ESP32 that texts me before my basil dies. It has saved the basil twice.', stack: 'C++, ESP32, Twilio' },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Martin Liu</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;700&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet" />
	</head>
	<body>
		<main>
			<header class="hero">
				<svg class="board" viewBox="0 0 1200 640" role="img" aria-labelledby="board-title">
					<title id="board-title">Martin Liu, computer science at UVA</title>

					{deco.map((d) => <path class="trace dim" d={d} />)}
					<circle class="via" cx="700" cy="80" r="9" />
					<circle class="via" cx="640" cy="140" r="9" />
					<circle class="via" cx="860" cy="560" r="9" />
					<circle class="via" cx="520" cy="560" r="9" />
					<circle class="via" cx="600" cy="540" r="9" />

					{pads.map((p) => (
						<g class="net" data-net={p.id}>
							<path class="trace" d={p.d} />
							<path class="pulse" d={p.d} pathLength="1000" />
						</g>
					))}

					<!-- Main chip -->
					<text class="silk small" x="440" y="186">U1</text>
					{pinsX.map((x) => <rect class="pin" x={x} y="186" width="18" height="16" />)}
					{pinsX.map((x) => <rect class="pin" x={x} y="438" width="18" height="16" />)}
					{pinsY.map((y) => <rect class="pin" x="426" y={y} width="16" height="18" />)}
					{pinsY.map((y) => <rect class="pin" x="758" y={y} width="16" height="18" />)}
					<rect class="chip" x="440" y="200" width="320" height="240" rx="6" />
					<circle class="dot" cx="466" cy="226" r="7" />
					<text class="chip-name" x="600" y="318" text-anchor="middle">MARTIN</text>
					<text class="chip-name" x="600" y="376" text-anchor="middle">LIU</text>
					<text class="chip-sub" x="600" y="414" text-anchor="middle">CS at UVA</text>

					<!-- Power LED -->
					<text class="silk small" x="900" y="92">D1</text>
					<rect class="led-pad" x="900" y="104" width="44" height="24" rx="3" />
					<rect class="led" x="908" y="108" width="28" height="16" rx="2" />

					<!-- Resistor -->
					<text class="silk small" x="250" y="300">R1</text>
					<rect class="part" x="250" y="312" width="64" height="26" rx="3" />

					{pads.map((p) => (
						<a href={p.href} class="pad-link" data-net={p.id}>
							<circle class="pad" cx={p.px} cy={p.py} r="22" />
							<circle class="pad-hole" cx={p.px} cy={p.py} r="8" />
							<text class="silk label" x={p.lx} y={p.ly} text-anchor={p.anchor}>{p.label}</text>
						</a>
					))}
				</svg>

				<nav class="mobile-nav" aria-label="Sections">
					{pads.map((p) => <a href={p.href} data-net={p.id}>{p.label}</a>)}
				</nav>

				<p class="intro">I build small, useful software and the occasional silly game. Hover a pad to follow its trace.</p>
			</header>

			<section id="about" class="block">
				<h2><span class="ref">J1</span> About</h2>
				<p>I'm a computer science student at the University of Virginia. I like projects that touch the real world: a sensor on a windowsill, a scraper that saves you a walk across Grounds, a game your friends actually play.</p>
				<p>Right now I'm learning Rust and looking for a summer internship.</p>
			</section>

			<section id="projects" class="block">
				<h2><span class="ref">U2 to U4</span> Projects</h2>
				<ul class="parts">
					{projects.map((p) => (
						<li class="footprint">
							<span class="ref">{p.ref}</span>
							<h3>{p.name}</h3>
							<p>{p.what}</p>
							<p class="stack">{p.stack}</p>
						</li>
					))}
				</ul>
			</section>

			<section id="contact" class="block">
				<h2><span class="ref">J2</span> Contact</h2>
				<p>The fastest way to reach me is email.</p>
				<div class="header-pins">
					<a href="mailto:bev8au@virginia.edu">Email me</a>
					<a href="https://github.com/bev8au">GitHub</a>
				</div>
			</section>
		</main>

		<script>
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const nets = document.querySelectorAll<SVGGElement>('.net');
			const light = (id: string, on: boolean) => {
				document.querySelector(`.net[data-net="${id}"]`)?.classList.toggle('live', on);
			};
			document.querySelectorAll<HTMLElement>('[data-net]:is(a)').forEach((a) => {
				const id = a.dataset.net!;
				a.addEventListener('pointerenter', () => light(id, true));
				a.addEventListener('pointerleave', () => light(id, false));
				a.addEventListener('focus', () => light(id, true));
				a.addEventListener('blur', () => light(id, false));
			});
			// Power-on: the LED comes on, then current runs down every trace once.
			if (!reduce) {
				document.body.classList.add('booting');
				setTimeout(() => nets.forEach((n) => n.classList.add('boot')), 500);
				setTimeout(() => {
					nets.forEach((n) => n.classList.remove('boot'));
					document.body.classList.remove('booting');
				}, 1900);
			}
		</script>

		<style is:global>
			:root {
				--board: #0f2d27;
				--board-deep: #0a211c;
				--trace: #24564a;
				--silk: #eef0e4;
				--gold: #f2c14e;
				--chip: #16181b;
				--led: #ff5a4e;
				--muted: #a7bdb4;
			}
			* { box-sizing: border-box; }
			html { background: var(--board); color: var(--silk); }
			body {
				margin: 0;
				font-family: 'IBM Plex Sans', system-ui, sans-serif;
				font-size: 1.0625rem;
				line-height: 1.6;
				background:
					radial-gradient(circle at 1px 1px, rgba(238, 240, 228, 0.05) 1px, transparent 1.5px) 0 0 / 24px 24px,
					radial-gradient(120% 70% at 50% 0%, #143a32, transparent 70%),
					var(--board);
			}
			h1, h2, h3, .chip-name, .silk { font-family: 'Chakra Petch', sans-serif; }

			.hero { max-width: 80rem; margin: 0 auto; padding: 2rem 1rem 3rem; }
			.board { display: block; width: 100%; height: auto; }

			.trace, .pulse { fill: none; stroke-width: 10; stroke-linejoin: round; stroke-linecap: round; }
			.trace { stroke: var(--trace); transition: stroke 0.2s; }
			.trace.dim { opacity: 0.7; }
			.pulse { stroke: #fff6d6; stroke-width: 6; stroke-dasharray: 80 1000; stroke-dashoffset: 80; opacity: 0; }
			.net.live .trace { stroke: var(--gold); }
			.net.live .pulse, .net.boot .pulse { opacity: 1; animation: flow 1.1s linear infinite; }
			.net.boot .pulse { animation-iteration-count: 1; }
			@keyframes flow { from { stroke-dashoffset: 80; } to { stroke-dashoffset: -1000; } }

			.via { fill: var(--board-deep); stroke: var(--gold); stroke-width: 4; }
			.pin { fill: #c9cdd1; }
			.chip { fill: var(--chip); stroke: #2a2d31; stroke-width: 2; }
			.dot { fill: #2b2e33; }
			.chip-name { fill: var(--silk); font-size: 62px; font-weight: 700; letter-spacing: 0.06em; }
			.chip-sub { fill: #9aa0a6; font-family: 'IBM Plex Sans', sans-serif; font-size: 20px; }
			.silk { fill: var(--silk); }
			.silk.small { font-size: 20px; font-weight: 500; }
			.silk.label { font-size: 30px; font-weight: 700; transition: fill 0.2s; }
			.part { fill: #2c2621; stroke: var(--silk); stroke-width: 2; }
			.led-pad { fill: var(--gold); }
			.led { fill: var(--led); filter: drop-shadow(0 0 10px var(--led)); }
			.booting .led { animation: power 0.3s 0.2s backwards; }
			@keyframes power { from { fill: #5a2622; filter: none; } }

			.pad { fill: var(--gold); transition: r 0.2s; }
			.pad-hole { fill: var(--board-deep); }
			.pad-link { cursor: pointer; outline: none; }
			.pad-link:hover .label, .pad-link:focus-visible .label { fill: var(--gold); }
			.pad-link:focus-visible .pad { stroke: var(--silk); stroke-width: 6; }

			.intro { max-width: 42ch; margin: 1.5rem auto 0; text-align: center; color: var(--muted); font-size: 1.2rem; }
			.mobile-nav { display: none; }

			.block { max-width: 60rem; margin: 0 auto; padding: 4rem 1rem; }
			.block > p { max-width: 62ch; font-size: 1.15rem; }
			h2 { font-size: clamp(2.25rem, 6vw, 3.5rem); line-height: 1.05; margin: 0 0 1.5rem; display: flex; align-items: baseline; gap: 1rem; }
			.ref { font-family: 'Chakra Petch', sans-serif; font-size: 1rem; font-weight: 500; color: var(--gold); }

			.parts { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
			.footprint {
				position: relative;
				padding: 1.75rem 1.5rem 1.5rem;
				border: 2px solid var(--silk);
				border-radius: 4px;
			}
			/* Pin-1 notch, like a silkscreened IC outline */
			.footprint::before {
				content: ''; position: absolute; top: -2px; left: 50%; translate: -50% 0;
				width: 28px; height: 14px; background: var(--board); border: 2px solid var(--silk); border-top: none; border-radius: 0 0 14px 14px;
			}
			.footprint .ref { position: absolute; top: 0.4rem; left: 0.75rem; }
			.footprint h3 { margin: 0.5rem 0 0.5rem; font-size: 1.75rem; }
			.footprint p { margin: 0; color: var(--muted); }
			.footprint .stack { margin-top: 1rem; color: var(--silk); font-size: 0.95rem; }

			.header-pins { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.5rem; }
			.header-pins a, .mobile-nav a {
				font-family: 'Chakra Petch', sans-serif; font-weight: 700; font-size: 1.2rem;
				color: var(--board-deep); background: var(--gold); text-decoration: none;
				padding: 0.75rem 1.4rem; border-radius: 4px;
				box-shadow: inset 0 0 0 4px var(--gold), inset 0 0 0 6px var(--board-deep);
			}
			.header-pins a:hover { background: #ffd877; }
			a:focus-visible { outline: 3px solid var(--silk); outline-offset: 3px; }

			@media (max-width: 700px) {
				.silk.label { display: none; }
				.mobile-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 1rem; }
				.mobile-nav a { font-size: 1rem; padding: 0.55rem 1rem; }
				.intro { font-size: 1.05rem; }
			}
			@media (prefers-reduced-motion: reduce) {
				.net.live .pulse { animation: none; opacity: 0; }
				.trace, .pad, .led { transition: none; }
			}
		</style>
	</body>
</html>
