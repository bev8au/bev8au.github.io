---
// Design A: Sticker lid. A graphite laptop lid covered in draggable die-cut stickers.
const stickers = [
	{ id: 'uva', text: 'CS @ UVA', shape: 'circle', color: 'sun', x: 9, y: 16, r: -12 },
	{ id: 'hoos', text: "Hoo's Free", sub: 'find an empty study room', shape: 'tag', color: 'pink', x: 70, y: 12, r: 6, href: '#projects' },
	{ id: 'beat', text: 'beatbox', sub: 'rhythm game, in a tab', shape: 'pill', color: 'cyan', x: 76, y: 66, r: -8, href: '#projects' },
	{ id: 'fri', text: 'ships on fridays', shape: 'rect', color: 'paper', x: 6, y: 70, r: 9 },
	{ id: 'rust', text: 'now learning Rust', shape: 'burst', color: 'pink', x: 24, y: 40, r: -4 },
	{ id: 'gh', text: 'github/bev8au', shape: 'pill', color: 'sun', x: 50, y: 6, r: 3, href: 'https://github.com/bev8au' },
];
const projects = [
	{ name: "Hoo's Free", what: 'Shows which study rooms on Grounds are empty right now, scraped from the booking system every five minutes.', stack: 'Python, FastAPI, Svelte', color: 'pink' },
	{ name: 'beatbox', what: 'A four-lane rhythm game that runs in the browser. Drop in any MP3 and it generates a chart from the beats.', stack: 'TypeScript, Web Audio', color: 'cyan' },
	{ name: 'Plant Pager', what: 'A soil-moisture sensor on an ESP32 that texts me before my basil dies. It has saved the basil twice.', stack: 'C++, ESP32, Twilio', color: 'sun' },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Martin Liu</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&display=swap" rel="stylesheet" />
	</head>
	<body>
		<main>
			<section class="lid" aria-label="Introduction">
				<div class="logo">
					<h1>Martin<br />Liu</h1>
					<p class="tagline">I build small, useful software and the occasional silly game.</p>
				</div>

				{stickers.map((s) => {
					const Tag = s.href ? 'a' : 'div';
					return (
						<Tag
							class={`sticker ${s.shape} ${s.color}`}
							style={`--x:${s.x}%;--y:${s.y}%;--r:${s.r}deg`}
							href={s.href}
							data-sticker
						>
							<span class="s-text">{s.text}</span>
							{s.sub && <span class="s-sub">{s.sub}</span>}
						</Tag>
					);
				})}

				<p class="hint">Stickers peel off. Drag them around.</p>
			</section>

			<section id="projects" class="projects">
				<h2>Things I've made</h2>
				<ul>
					{projects.map((p) => (
						<li class={`project ${p.color}`}>
							<h3>{p.name}</h3>
							<p>{p.what}</p>
							<p class="stack">{p.stack}</p>
						</li>
					))}
				</ul>
			</section>

			<section class="contact">
				<h2>Say hi</h2>
				<p>I'm looking for a summer internship where I get to ship things people use.</p>
				<div class="links">
					<a class="btn sun" href="mailto:bev8au@virginia.edu">Email me</a>
					<a class="btn paper" href="https://github.com/bev8au">See my GitHub</a>
				</div>
			</section>
		</main>

		<script>
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			let top = 10;
			document.querySelectorAll<HTMLElement>('[data-sticker]').forEach((el) => {
				let startX = 0, startY = 0, ox = 0, oy = 0, moved = false, dragging = false;
				el.addEventListener('pointerdown', (e) => {
					dragging = true; moved = false;
					startX = e.clientX; startY = e.clientY;
					ox = parseFloat(el.dataset.dx || '0'); oy = parseFloat(el.dataset.dy || '0');
					el.setPointerCapture(e.pointerId);
					el.style.zIndex = String(++top);
					el.classList.add('lifted');
				});
				el.addEventListener('pointermove', (e) => {
					if (!dragging) return;
					const dx = e.clientX - startX, dy = e.clientY - startY;
					if (Math.abs(dx) + Math.abs(dy) > 4) moved = true;
					el.dataset.dx = String(ox + dx); el.dataset.dy = String(oy + dy);
					el.style.translate = `${ox + dx}px ${oy + dy}px`;
				});
				const end = () => { dragging = false; el.classList.remove('lifted'); };
				el.addEventListener('pointerup', end);
				el.addEventListener('pointercancel', end);
				// A drag shouldn't count as a click on link stickers.
				el.addEventListener('click', (e) => { if (moved) e.preventDefault(); });
				if (!reduce) el.classList.add('slap');
			});
		</script>

		<style is:global>
			:root {
				--lid: #2a2b31;
				--lid-hi: #3a3c44;
				--ink: #17171b;
				--text: #ebe9e4;
				--muted: #a9a8b0;
				--paper: #f7f5ef;
				--pink: #ff4f9a;
				--sun: #ffd447;
				--cyan: #3fd0e0;
			}
			* { box-sizing: border-box; }
			html { background: var(--lid); color: var(--text); }
			body {
				margin: 0;
				font-family: 'Bricolage Grotesque', system-ui, sans-serif;
				font-size: 1.125rem;
				line-height: 1.5;
			}
			a:focus-visible { outline: 3px solid var(--cyan); outline-offset: 4px; }

			.lid {
				position: relative;
				min-height: 100svh;
				overflow: hidden;
				background:
					radial-gradient(120% 80% at 30% 0%, var(--lid-hi), transparent 60%),
					var(--lid);
				display: grid;
				place-items: center;
				padding: 4rem 1rem;
			}
			.logo { text-align: center; position: relative; z-index: 1; pointer-events: none; }
			.logo h1 {
				margin: 0;
				font-size: clamp(4.5rem, 16vw, 12rem);
				font-weight: 800;
				font-variation-settings: 'opsz' 96;
				line-height: 0.82;
				letter-spacing: -0.04em;
				color: transparent;
				/* Debossed into the aluminium, like a laptop logo */
				background: linear-gradient(180deg, #575a64, #2b2c32);
				-webkit-background-clip: text;
				background-clip: text;
				text-shadow: 0 1px 0 rgba(255, 255, 255, 0.07);
			}
			.tagline { margin: 1.5rem auto 0; max-width: 26ch; color: var(--muted); font-size: 1.25rem; }
			.hint { position: absolute; bottom: 1.25rem; left: 0; right: 0; text-align: center; color: var(--muted); font-size: 0.95rem; margin: 0; }

			.sticker {
				position: absolute;
				left: var(--x);
				top: var(--y);
				rotate: var(--r);
				z-index: 2;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 0.1rem;
				padding: 0.7rem 1.2rem;
				color: var(--ink);
				text-decoration: none;
				font-weight: 800;
				font-size: clamp(1rem, 2vw, 1.35rem);
				line-height: 1.05;
				text-align: center;
				cursor: grab;
				touch-action: none;
				user-select: none;
				/* The white die-cut border every laptop sticker has */
				box-shadow: 0 0 0 6px var(--paper), 0 10px 18px rgba(0, 0, 0, 0.45);
				transition: scale 0.15s, box-shadow 0.15s;
			}
			.sticker.lifted { cursor: grabbing; scale: 1.08; box-shadow: 0 0 0 6px var(--paper), 0 22px 34px rgba(0, 0, 0, 0.5); }
			.s-sub { font-weight: 400; font-size: 0.7em; }
			.sticker.circle { width: 8.5rem; height: 8.5rem; border-radius: 50%; }
			.sticker.pill { border-radius: 999px; padding: 0.9rem 1.6rem; }
			.sticker.tag { border-radius: 0.6rem 2.5rem 2.5rem 0.6rem; padding-right: 2.2rem; }
			.sticker.rect { border-radius: 0.25rem; font-family: inherit; }
			.sticker.burst {
				width: 9rem; height: 9rem; padding: 1.5rem;
				background: none;
				box-shadow: none;
				/* The star shape is clipped on a pseudo-element so the filter can draw the white edge around it */
				filter: drop-shadow(5px 0 0 var(--paper)) drop-shadow(-5px 0 0 var(--paper)) drop-shadow(0 5px 0 var(--paper)) drop-shadow(0 -5px 0 var(--paper)) drop-shadow(0 8px 10px rgba(0, 0, 0, 0.45));
			}
			.sticker.burst::before {
				content: '';
				position: absolute;
				inset: 0;
				z-index: -1;
				background: var(--fill);
				clip-path: polygon(50% 0, 61% 18%, 82% 10%, 80% 32%, 100% 40%, 85% 56%, 96% 76%, 74% 78%, 68% 100%, 50% 86%, 32% 100%, 26% 78%, 4% 76%, 15% 56%, 0 40%, 20% 32%, 18% 10%, 39% 18%);
			}
			.sticker.lifted.burst { box-shadow: none; }
			.pink { --fill: var(--pink); background: var(--fill); }
			.sun { --fill: var(--sun); background: var(--fill); }
			.cyan { --fill: var(--cyan); background: var(--fill); }
			.paper { --fill: var(--paper); background: var(--fill); }
			.sticker.paper { border: 2px dashed var(--ink); }

			@keyframes slap {
				from { scale: 1.6; opacity: 0; rotate: calc(var(--r) - 20deg); }
				60% { scale: 0.95; opacity: 1; }
				to { scale: 1; rotate: var(--r); }
			}
			.sticker.slap { animation: slap 0.45s cubic-bezier(0.3, 1.4, 0.5, 1) backwards; }
			.sticker.slap:nth-of-type(1) { animation-delay: 0.1s; }
			.sticker.slap:nth-of-type(2) { animation-delay: 0.22s; }
			.sticker.slap:nth-of-type(3) { animation-delay: 0.34s; }
			.sticker.slap:nth-of-type(4) { animation-delay: 0.46s; }
			.sticker.slap:nth-of-type(5) { animation-delay: 0.58s; }
			.sticker.slap:nth-of-type(6) { animation-delay: 0.7s; }

			.projects, .contact { max-width: 68rem; margin: 0 auto; padding: 6rem 1rem; }
			h2 { font-size: clamp(2.5rem, 7vw, 4.5rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1; margin: 0 0 2.5rem; }
			.projects ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); }
			.project { color: var(--ink); padding: 1.75rem; border-radius: 1.25rem; box-shadow: 0 0 0 6px var(--paper); }
			.project:nth-child(1) { rotate: -1.5deg; }
			.project:nth-child(2) { rotate: 1deg; margin-top: 2rem; }
			.project:nth-child(3) { rotate: -0.5deg; }
			.project h3 { margin: 0 0 0.5rem; font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; }
			.project p { margin: 0; }
			.project .stack { margin-top: 1rem; font-weight: 600; opacity: 0.75; font-size: 0.95rem; }

			.contact { padding-bottom: 8rem; }
			.contact p { max-width: 40ch; color: var(--muted); font-size: 1.35rem; margin: 0 0 2rem; }
			.links { display: flex; flex-wrap: wrap; gap: 1.25rem; }
			.btn {
				color: var(--ink); text-decoration: none; font-weight: 800; font-size: 1.25rem;
				padding: 0.9rem 1.6rem; border-radius: 999px; box-shadow: 0 0 0 5px var(--paper);
				transition: rotate 0.15s;
			}
			.btn:hover { rotate: -3deg; }

			@media (max-width: 640px) {
				.sticker.circle, .sticker.burst { width: 6.5rem; height: 6.5rem; font-size: 0.95rem; }
				.sticker { font-size: 0.95rem; padding: 0.5rem 0.9rem; }
				.s-sub { display: none; }
				.project:nth-child(2) { margin-top: 0; }
			}
			@media (prefers-reduced-motion: reduce) {
				.sticker, .btn { transition: none; }
			}
		</style>
	</body>
</html>
