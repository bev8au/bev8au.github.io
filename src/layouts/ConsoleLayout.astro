---
// Page shell for console pages outside the debrief page: header plate, tab strip, footer.
import '../styles/console.css';
import { HOME, tabs, type TabKey } from '../data/nav';

interface Props {
	title: string;
	description?: string;
	active: TabKey;
	// Right side of the header plate, after the vessel name
	status: string;
}
const { title, description, active, status } = Astro.props;
const hrefOf = (t: (typeof tabs)[number]) => ('href' in t ? t.href : `${HOME}${t.hash}`);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Michroma&family=Barlow:ital,wght@0,400;0,500;0,600;1,400&family=Barlow+Condensed:wght@500;600&display=swap" rel="stylesheet" />
	</head>
	<body>
		<div class="chassis">
			<header class="plate">
				<a class="mark" href={HOME} aria-label="Martin Liu, back to the solar system">
					<svg viewBox="0 0 40 40" aria-hidden="true">
						<ellipse cx="20" cy="20" rx="17" ry="7" transform="rotate(-24 20 20)" />
						<circle cx="20" cy="20" r="6" />
						<circle class="moon" cx="35" cy="13" r="2.4" />
					</svg>
					<span class="wordmark">Martin Liu</span>
				</a>
				<p class="callsign">Survey vessel UVA McIntire <span class="sep">//</span> {status}</p>
			</header>

			<nav class="tabs" aria-label="Sections">
				{tabs.map((t) => <a href={hrefOf(t)} class:list={{ on: t.key === active }} aria-current={t.key === active ? 'page' : undefined}>{t.label}</a>)}
			</nav>

			<main>
				<slot />
			</main>

			<footer class="foot">
				<p>© 2026 Martin Liu</p>
				<p>Built with Astro <span class="sep">//</span> Hosted on GitHub Pages</p>
			</footer>
		</div>
	</body>
</html>
