---
// A photo framed like a console sensor feed: duotone image, scanlines, one slow scan sweep,
// amber corner brackets, a tracking box around the face, and short data labels.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	// 'id': the cut-out studio portrait on a tactical grid. 'field': a photo with its own background.
	kind: 'id' | 'field';
	labels: { topLeft: string; topRight: string };
	caption: { title: string; sub: string };
	// Face position in percent of the frame, for the tracking box
	face: { left: number; top: number; width: number; height: number };
	sizes: string;
	loading?: 'eager' | 'lazy';
}
const { src, alt, kind, labels, caption, face, sizes, loading = 'lazy' } = Astro.props;
---

<figure class:list={['portrait', kind]}>
	<div class="frame">
		{kind === 'id' && <div class="grid" aria-hidden="true"></div>}
		<Image class="photo" src={src} alt={alt} widths={[240, 360, 480, 720, 960]} sizes={sizes} format="webp" loading={loading} />
		<div class="scan" aria-hidden="true"></div>
		<div class="face" aria-hidden="true" style={`left:${face.left}%;top:${face.top}%;width:${face.width}%;height:${face.height}%`}></div>
		<span class="corner tl" aria-hidden="true"></span>
		<span class="corner tr" aria-hidden="true"></span>
		<span class="corner bl" aria-hidden="true"></span>
		<span class="corner br" aria-hidden="true"></span>
		<span class="label top-left" aria-hidden="true">{labels.topLeft}</span>
		<span class="label top-right" aria-hidden="true">{labels.topRight}</span>
	</div>
	<figcaption>
		<span class="cap-title">{caption.title}</span>
		<span class="cap-sub">{caption.sub}</span>
	</figcaption>
</figure>

<style>
	/* Stay compact at the top even when a parent grid row is taller than the figure */
	.portrait { margin: 0; display: grid; gap: 8px; align-content: start; align-self: start; }
	.frame {
		position: relative;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: radial-gradient(ellipse 70% 60% at 50% 38%, #2c3d62 0%, #141c30 75%);
		border: 1px solid #4d6088;
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.35);
	}
	/* Range grid behind the cut-out portrait */
	.grid {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(rgba(167, 182, 209, 0.09) 1px, transparent 1px) 0 0 / 100% 24px,
			linear-gradient(90deg, rgba(167, 182, 209, 0.09) 1px, transparent 1px) 0 0 / 24px 100%,
			linear-gradient(90deg, transparent calc(50% - 0.5px), rgba(242, 177, 59, 0.22) calc(50% - 0.5px), rgba(242, 177, 59, 0.22) calc(50% + 0.5px), transparent calc(50% + 0.5px));
	}
	.photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; }
	.field .photo { object-position: 50% 30%; }

	/* Scanlines, a faint halftone, edge vignette, and one slow sweep line */
	.scan {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			repeating-linear-gradient(0deg, rgba(5, 8, 16, 0.22) 0 1px, transparent 1px 3px),
			radial-gradient(rgba(228, 236, 247, 0.06) 0.6px, transparent 0.8px) 0 0 / 3px 3px,
			radial-gradient(ellipse 85% 75% at 50% 45%, transparent 55%, rgba(5, 8, 16, 0.55) 100%);
	}
	.scan::after {
		content: '';
		position: absolute;
		left: 0; right: 0;
		top: -20%;
		height: 18%;
		background: linear-gradient(180deg, transparent, rgba(167, 182, 209, 0.12) 80%, rgba(228, 236, 247, 0.35) 100%);
		animation: sweep 7s linear infinite;
	}
	@keyframes sweep { to { top: 110%; } }
	@media (prefers-reduced-motion: reduce) { .scan::after { display: none; } }

	/* Tracking box around the face, ice-thin with short ticks at the edges */
	.face {
		position: absolute;
		border: 1px solid rgba(228, 236, 247, 0.35);
		pointer-events: none;
	}
	.face::before, .face::after {
		content: '';
		position: absolute;
		left: 50%;
		width: 1px; height: 8px;
		background: rgba(228, 236, 247, 0.6);
	}
	.face::before { top: -9px; }
	.face::after { bottom: -9px; }

	.corner { position: absolute; width: 16px; height: 16px; border: 0 solid var(--amber); pointer-events: none; }
	.tl { top: 8px; left: 8px; border-top-width: 2px; border-left-width: 2px; }
	.tr { top: 8px; right: 8px; border-top-width: 2px; border-right-width: 2px; }
	.bl { bottom: 8px; left: 8px; border-bottom-width: 2px; border-left-width: 2px; }
	.br { bottom: 8px; right: 8px; border-bottom-width: 2px; border-right-width: 2px; }

	.label {
		position: absolute;
		top: 12px;
		padding: 2px 6px;
		font: 600 0.72rem/1.2 var(--data);
		letter-spacing: 0.06em;
		color: var(--ice);
		background: rgba(9, 14, 28, 0.6);
	}
	.top-left { left: 30px; }
	.top-right { right: 30px; color: var(--amber); }
	/* Small frames only have room for one label */
	.frame { container-type: inline-size; }
	@container (max-width: 170px) {
		.top-right { display: none; }
	}

	figcaption { display: grid; gap: 2px; }
	.cap-title { font: 400 0.82rem/1.3 var(--display); letter-spacing: 0.06em; color: var(--ice); }
	.cap-sub { font: 600 0.82rem/1.3 var(--data); letter-spacing: 0.04em; color: var(--dim); }
</style>
